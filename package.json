{
  "name": "nestjs-joi",
  "version": "2.0.0",
  "description": "Easy to use JoiPipe as an interface between joi and NestJS with optional decorator-based schema construction.",
  "scripts": {
    "test:unit": "NODE_ENV=testing jest -c .jest-unit.json --watchAll",
    "test:unit:debug": "NODE_ENV=testing node --inspect-brk=0.0.0.0:9229 node_modules/.bin/jest -c .jest-unit.json --runInBand",
    "test:unit:once": "NODE_ENV=testing jest -c .jest-unit.json",
    "test:api": "NODE_ENV=testing jest -c .jest-api.json --watchAll",
    "test:api:debug": "NODE_ENV=testing node --inspect-brk=0.0.0.0:9229 node_modules/.bin/jest -c .jest-api.json --runInBand",
    "test:api:once": "NODE_ENV=testing jest -c .jest-api.json",
    "clean": "rm -rf dist/",
    "compile": "npm run clean && echo Compiling... && tsc -p .",
    "compile:dist": "npm run clean && echo Compiling... && tsc -p tsconfig.dist.json",
    "check": "eslint src test",
    "fix": "eslint --fix src test",
    "typecheck": "tsc -p . --noEmit && tsc -p test/api --noEmit && tsc -p tsconfig.dist.json --noEmit",
    "prepare": "husky"
  },
  "keywords": [
    "nestjs",
    "joi"
  ],
  "author": "William Hefter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/whefter/nestjs-joi"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "typings": "index.d.ts",
  "dependencies": {
    "joi-class-decorators": "^2.0.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^7.0.0 || ^8.0.0 || ^9.0.0 || ^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^7.0.0 || ^8.0.0 || ^9.0.0 || ^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/microservices": "^7.0.0 || ^8.0.0 || ^9.0.0 || ^10.0.0 || ^11.0.0 || ^12.0.0",
    "joi": "^17.13.9 || ^18.3.1",
    "rxjs": "^7.1.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/microservices": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "engines": {
    "node": ">= 22"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@apollo/server": "^5.5.2",
    "@as-integrations/express5": "^1.1.2",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@nestjs/apollo": "^13.4.5",
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "@nestjs/graphql": "^13.4.5",
    "@nestjs/microservices": "^11.2.10",
    "@nestjs/platform-express": "^11.2.10",
    "@nestjs/testing": "^11.2.10",
    "@tsconfig/node22": "^22.0.7",
    "@tsconfig/strictest": "^2.0.9",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.27",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsdoc": "^65.4.7",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "graphql": "^16.15.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "joi": "^18.3.2",
    "lint-staged": "^17.6.0",
    "lodash": "^4.18.1",
    "prettier": "^3.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "overrides": {
    "@graphql-tools/utils": "^12.0.4"
  }
}
